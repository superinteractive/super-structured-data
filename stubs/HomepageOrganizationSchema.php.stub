<?php

declare(strict_types=1);

namespace App\Schemas;

use Spatie\SchemaOrg\BaseType;
use Spatie\SchemaOrg\Schema;
use Superinteractive\StructuredData\Schemas\BaseSchema;

class HomepageOrganizationSchema extends BaseSchema
{
    public function applies(): bool
    {
        return $this->context->collection() === 'pages' && $this->context->blueprint() === 'home';
    }

    /**
     * @return array<int, BaseType>
     */
    public function buildSchemas(): array
    {
        $schema = Schema::organization()
            ->id($this->context->url().'#organization')
            ->name((string) config('app.name', 'Website'))
            ->url($this->context->url());

        return [$schema];
    }

    /**
     * @return array<int, string>
     */
    public function scripts(): array
    {
        if (! $this->applies()) {
            return [];
        }

        return array_map(
            static fn (BaseType $schema): string => $schema->toScript(),
            $this->buildSchemas(),
        );
    }
}
